# ─────────────────────────────────────────────────────────────
#  Minecraft server settings
#  Edit in the web panel (Settings, then "Save & restart"),
#  or edit server.env on the server and run:  ./mc restart
# ─────────────────────────────────────────────────────────────

# You must accept the Minecraft EULA: https://aka.ms/MinecraftEULA
EULA=TRUE

# Server type. The default runs MODS + PLUGINS together:
#   ARCLIGHT = hybrid: NeoForge mods in data/mods AND Bukkit/Paper plugins
#              in data/plugins, at the same time            <- default
#   MOHIST   = hybrid alternative (Forge 1.20.1 mods + plugins), try it if
#              Arclight gives you trouble: ./mc mode mohist
#   PAPER    = plugins only (fastest, most stable)
#   FABRIC / NEOFORGE / FORGE = mods only
#   VANILLA  = no mods or plugins
# Switch with:  ./mc mode hybrid | mohist | paper | fabric | neoforge | forge | vanilla
# Use ./mc mode (over SSH) rather than editing TYPE by hand: it also sets VERSION
# and the Java version each type needs.
TYPE=ARCLIGHT
# Which mod loader the Arclight hybrid uses: NEOFORGE, FORGE or FABRIC.
# Your mods must be built for this loader.
ARCLIGHT_TYPE=NEOFORGE

# Minecraft version. Hybrid servers lag behind the newest Minecraft, so this
# is pinned to a version Arclight supports. Mods AND plugins must match it.
# (Mohist: 1.20.1. Paper/Fabric/NeoForge alone can use LATEST.)
VERSION=1.21.1

# Java heap size. 3G is safe on a machine with 4GB of RAM total
# (the OS and Java itself need the rest). If the machine has 6GB+,
# use 4G. install.sh sets this for you automatically.
# A modded server with lots of mods needs more; keep the mod list
# light (~30-50 mods) on 4GB.
MEMORY=3G

# Tuned garbage collector flags (recommended).
USE_AIKAR_FLAGS=true

# ── Auto-download mods/plugins from Modrinth ──────────────────
# Comma-separated Modrinth project slugs (the bit after /mod/ or
# /plugin/ in the URL), downloaded on every start with dependencies.
# Works best with PAPER / FABRIC / NEOFORGE. On a hybrid (ARCLIGHT /
# MOHIST) the simplest and most reliable way is to drop the .jar files
# in yourself:  mods -> data/mods   plugins -> data/plugins
#   Paper example:  MODRINTH_PROJECTS=luckperms,essentialsx,worldedit,chunky
#   Fabric example: MODRINTH_PROJECTS=fabric-api,lithium,ferrite-core,chunky
MODRINTH_PROJECTS=
MODRINTH_DOWNLOAD_DEPENDENCIES=required

# ── Gameplay ──────────────────────────────────────────────────
MOTD=My Minecraft Server
MAX_PLAYERS=10
DIFFICULTY=normal
MODE=survival
# Lower = less RAM/CPU. 10/8 are good for a 4GB server.
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
# Set to FALSE only for cracked/offline clients (not recommended).
ONLINE_MODE=TRUE
# Whitelist: comma-separated player names. Leave empty for no whitelist.
WHITELIST=
# Operators (admins): comma-separated player names.
OPS=

# ── Web panel (http://SERVER-IP:8080) ─────────────────────────
PANEL_USER=admin
# Generated automatically on first start if left empty.
PANEL_PASSWORD=

# Remote console used by the web panel and ./mc cmd. Change this.
RCON_PASSWORD=change-me-please
TZ=UTC
